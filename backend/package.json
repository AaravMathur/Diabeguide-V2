{
  "name": "diabeguide-backend",
  "version": "1.0.0",
  "description": "Backend API server for DiabeGuide",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:mongoose --external:bcryptjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "nodemailer": "^9.0.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4"
  }
}
